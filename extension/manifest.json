{
  "manifest_version": 3,
  "name": "IUH Fast Login",
  "version": "1.0.0",
  "description": "Tự động đăng nhập IUH: cổng sinh viên (sv.iuh.edu.vn, bỏ qua captcha), LMS Moodle (lms.iuh.edu.vn) và điền sẵn form Đăng ký học phần (dkhp.iuh.edu.vn).",
  "permissions": ["storage", "declarativeNetRequest", "cookies", "alarms"],
  "host_permissions": [
    "*://sv.iuh.edu.vn/*",
    "*://lms.iuh.edu.vn/*",
    "*://dkhp.iuh.edu.vn/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "block_captcha", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://sv.iuh.edu.vn/*"],
      "js": ["redirect.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://sv.iuh.edu.vn/sinh-vien-dang-nhap.html*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://lms.iuh.edu.vn/login/index.php*"],
      "js": ["lms.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://sv.iuh.edu.vn/lich-theo-tuan.html*"],
      "js": ["schedule.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://dkhp.iuh.edu.vn/*"],
      "js": ["dkhp.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "IUH Fast Login",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "iuh-fast-login@langpn",
      "strict_min_version": "113.0"
    }
  }
}
